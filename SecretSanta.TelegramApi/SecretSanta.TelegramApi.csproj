<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <UserSecretsId>d2d25208-1bfa-41a8-a5e0-d4c947fd88ed</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretSanta.Shared/SecretSanta.Shared.csproj" />
    <ProjectReference Include="../SecretSanta.Localization/SecretSanta.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../SecretSanta.TelegramWebApp/**/*" Exclude="../SecretSanta.TelegramWebApp/README.md" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
